# Every VITE_ value is public. Never put secrets or customer data here.

# Browser-facing API base path. Keep it same-origin so the session cookie is first party.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api during local development.
VITE_DEV_PROXY_TARGET=http://localhost:8000

# Development only. Enables in-browser mock handlers. Production builds reject this.
# VITE_ENABLE_MOCKS=true
